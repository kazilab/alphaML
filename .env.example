# Copy to .env (git-ignored) and fill in. docker compose reads .env; for alphaml-web without Docker, set these as
# environment variables.

# Outgoing email for password-reset links. Leave ALPHAML_SMTP_HOST empty to run without email: the administrator
# then resets passwords with `alphaml-web users reset-password EMAIL`.
# Gmail / Google Workspace: smtp.gmail.com, 587, starttls, and an App Password.
# Outlook / Microsoft 365:  smtp.office365.com, 587, starttls (if SMTP authentication is allowed).
ALPHAML_SMTP_HOST=smtp.example.org
ALPHAML_SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (a local relay)
ALPHAML_SMTP_SECURITY=starttls
ALPHAML_SMTP_USERNAME=
ALPHAML_SMTP_PASSWORD=
ALPHAML_SMTP_FROM='alphaML <noreply@example.org>'

# Address users open alphaML at, for the links in emails, e.g. https://alphaml.example.org.
# Empty: the address of the request, which is fine on this computer.
ALPHAML_PUBLIC_URL=

# Shown in the privacy notice (GDPR Article 13): who runs this server, and how to contact them about personal data
ALPHAML_OPERATOR='Example Lab, Example University'
ALPHAML_PRIVACY_CONTACT=privacy@example.org

# Serving a public host name (e.g. a Cloudflare Tunnel to http://localhost:8765):
# ALPHAML_ALLOWED_HOSTS=localhost,127.0.0.1,alphaml.example.org
# ALPHAML_COOKIE_SECURE=1
# ALPHAML_CLIENT_IP_HEADER=CF-Connecting-IP
